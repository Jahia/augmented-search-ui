# Local configuration — copy to `.env` and add your license.
#
#   cp .env.example .env
#   base64 -i /path/to/your/license.xml    # paste onto the JAHIA_LICENSE line

# REQUIRED, base64-encoded license *content*, not a path
JAHIA_LICENSE=

# JAHIA_USER is a `user:password` pair
JAHIA_USER=root:root1234
JAHIA_PASSWORD=root1234

JAHIA_PORT=8080
JAHIA_KARAF_PORT=8101
JAHIA_JPDA_PORT=8000
ELASTICSEARCH_PORT=9200

# Change the images used in the stack
# JAHIA_IMAGE=jahia/jahia-ee:8.2
# ES_BASE_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.1.3

# JPDA on JAHIA_JPDA_PORT.
# JAHIA_DEBUG=true

# Only for publishing to Nexus by hand; CI uses repository secrets.
# NEXUS_USERNAME=
# NEXUS_PASSWORD=
